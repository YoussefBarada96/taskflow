# Copy this file to .env and fill in real values. Never commit .env.

# Runtime connection used by the app. On Neon this is the POOLED string (host contains "-pooler").
# Locally you can use the same direct string for both variables.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/taskflow?schema=public"

# Direct (non-pooled) connection, used only by Prisma for migrations.
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/taskflow?schema=public"

# Generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=""

# Needed when running a production build anywhere except Vercel (including `npm start` locally).
# Vercel is detected automatically, so leave this out there.
# AUTH_TRUST_HOST=true
